{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "src/renderer/**/*",
    "src/probe.ts",
    "kit/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
