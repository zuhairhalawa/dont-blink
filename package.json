{
  "name": "heartline-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Starter kit for desktop apps that react to live pulse and breathing via webcam",
  "type": "commonjs",
  "main": "dist/scare-meter/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json",
    "start": "electron dist/scare-meter/main.js",
    "demo": "electron dist/scare-meter/main.js --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@vitest/coverage-v8": "2.1.8",
    "esbuild": "0.21.5",
    "electron": "33.2.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "koffi@2.16.3": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
  }
}
