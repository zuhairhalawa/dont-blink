{
  "name": "dont-blink",
  "version": "0.1.0",
  "private": true,
  "description": "A horror game you play with your eyes: blink and the Watcher moves closer. Blinks and pulse read from a webcam with the Presage SmartSpectra SDK.",
  "type": "commonjs",
  "main": "dist/app/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "probe": "node scripts/build.mjs --probe && electron dist/probe/main.js",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json",
    "start": "electron dist/app/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@smartspectra/node-sdk": "3.4.0",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "electron": "33.2.1",
    "esbuild": "0.21.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "koffi@2.16.3": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
  }
}
