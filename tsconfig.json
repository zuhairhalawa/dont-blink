{
  "compilerOptions": {
    /* Language and environment */
    "target": "ES2022",
    "lib": ["ES2022"],
    "useDefineForClassFields": true,

    /* Module */
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Output */
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Strict */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "kit/*": ["./kit/*"]
    },

    /* Other */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "kit/**/*",
    "apps/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "coverage"
  ]
}
